{
    "name": "@audiomesh/backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "AudioMesh backend - figtree-based voice/audio routing API",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc -p .",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "update:jitsi-lib": "node scripts/update-jitsi-lib.mjs"
    },
    "dependencies": {
        "@audiomesh/schemas": "*",
        "@discordjs/opus": "^0.10.0",
        "@roamhq/wrtc": "^0.10.0",
        "better-sqlite3": "^12.9.0",
        "figtree": "git+https://github.com/stefanwerfling/figtree.git#claude",
        "figtree-schemas": "github:stefanwerfling/figtree-schemas",
        "jsdom": "^30.0.1",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^0.3.28",
        "vts": "github:OpenSourcePKG/vts",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/express": "^5.0.6",
        "@types/node": "^22.9.0",
        "@types/ws": "^8.5.13",
        "tsx": "^4.19.2",
        "vitest": "^2.1.9"
    }
}
