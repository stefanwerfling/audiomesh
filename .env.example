# AudioMesh deploy-time environment (infra only — app settings live in the UI).
# Copy to .env for docker compose. NEVER commit real secrets.

# Local admin login (change for anything beyond local use).
AUDIOMESH_ADMIN_USER=admin
AUDIOMESH_ADMIN_PASSWORD=admin

# HMAC secret for bearer tokens. Set a long random value in production;
# if empty, a random secret is generated per boot (tokens don't survive a restart).
AUDIOMESH_JWT_SECRET=

# Database (defaults to SQLite in the data volume). For MariaDB:
# AUDIOMESH_DATABASE_KIND=mariadb
# AUDIOMESH_DATABASE_HOST=db
# AUDIOMESH_DATABASE_PORT=3306
# AUDIOMESH_DATABASE_NAME=audiomesh
# AUDIOMESH_DATABASE_USER=audiomesh
# AUDIOMESH_DATABASE_PASSWORD=change-me
